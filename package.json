{
  "name": "easedrive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=server/.env server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "smoke-check": "node scripts/smoke-check.js",
    "start": "node --env-file-if-exists=server/.env server/index.js",
    "promote-admin": "node server/promote-admin.js"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "twilio": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
